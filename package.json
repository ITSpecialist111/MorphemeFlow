{
  "name": "morphemeflow",
  "version": "0.2.0",
  "private": true,
  "description": "Morpheme highlighting, syllable micro-kerning, and adaptive typography to help people with dyslexia read — delivered as a browser extension and native reader app.",
  "type": "module",
  "workspaces": [
    "packages/engine-ts",
    "packages/web"
  ],
  "scripts": {
    "dev:web": "npm -w packages/web run dev",
    "dev:reader": "cd apps/reader-windows && tauri dev",
    "build": "npm run build:engine && npm run build:web",
    "build:reader": "cd apps/reader-windows && tauri build",
    "build:web": "npm -w packages/web run build",
    "build:engine": "npm -w packages/engine-ts run build",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm -w packages/engine-ts run typecheck && npm -w packages/web run typecheck",
    "lint": "eslint \"packages/**/src/**/*.{ts,tsx}\""
  },
  "keywords": [
    "dyslexia",
    "accessibility",
    "morpheme",
    "reading",
    "browser-extension"
  ],
  "author": "MorphemeFlow Contributors",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/chrome": "^0.1.38",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "hyphenation.en-us": "^0.2.1",
    "hypher": "^0.2.5"
  }
}
