{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "declaration": false,
    "sourceMap": true,
    "outDir": "dist",
    "paths": {
      "@morphemeflow/engine": ["../engine/src/index.ts"],
      "@morphemeflow/engine/*": ["../engine/src/*"]
    }
  },
  "include": ["src/**/*.ts", "../engine/src/**/*.ts", "../engine/data/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
