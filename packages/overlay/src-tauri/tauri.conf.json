{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "MorphemeFlow",
  "version": "0.1.0",
  "identifier": "com.morphemeflow.overlay",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "overlay",
        "title": "MorphemeFlow Overlay",
        "fullscreen": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "url": "overlay.html"
      },
      {
        "label": "settings",
        "title": "MorphemeFlow Settings",
        "width": 480,
        "height": 640,
        "resizable": true,
        "visible": false,
        "url": "settings.html"
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "plugins": {}
}
